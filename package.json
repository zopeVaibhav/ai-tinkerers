{
    "name": "shared-object",
    "private": true,
    "packageManager": "bun@1.3.14",
    "engines": {
        "node": ">=20.9.0"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "generate": "turbo run generate",
        "db:push": "turbo run db:push",
        "db:studio": "bun run --filter @repo/database studio",
        "build": "turbo run build",
        "typecheck": "turbo run typecheck",
        "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
        "db:seed": "bun run --filter @repo/database db:seed",
        "test": "bun test packages apps",
        "db:clear": "bun run --filter @repo/database db:clear",
        "db:demo": "bun run --filter @repo/database db:demo"
    },
    "devDependencies": {
        "prettier": "^3.9.6",
        "turbo": "^2.10.9",
        "typescript": "^5.9.0"
    }
}
