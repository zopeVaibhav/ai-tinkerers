{
    "name": "@repo/database",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "generate": "bun --env-file=../../.env x prisma generate",
        "db:push": "bun --env-file=../../.env x prisma db push",
        "db:migrate": "bun --env-file=../../.env x prisma migrate dev",
        "db:seed": "bun --env-file=../../.env run src/seed.ts",
        "studio": "bun --env-file=../../.env x prisma studio",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@prisma/client": "^6.19.0",
        "dotenv": "^17.4.2"
    },
    "devDependencies": {
        "@types/node": "^22.20.2",
        "dotenv": "^17.4.2",
        "prisma": "^6.19.0",
        "typescript": "^5.9.0"
    }
}
