generator client {
    provider = "prisma-client-js"
    output   = "../generated/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Severity {
    low
    medium
    high
}

enum Status {
    triage
    awaiting_approval
    approved
    resolved
}

enum Surface {
    slack
    telegram
    web
}

enum Audience {
    engineer
    lead
    customer
}

enum ActionType {
    intake
    acknowledge
    propose
    approve
    reject
    resolve
    note
    reframe
}

/// One shared object. Every surface renders this and nothing else.
model Issue {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    version   Int      @default(0)

    raisedBy String
    raisedOn Surface

    what           String
    severity       Severity @default(low)
    affected       Int      @default(0)
    acknowledgedBy String?
    proposedFix    String?
    approvedBy     String?
    status         Status   @default(triage)

    /// The agent's wording of the same facts, keyed by audience.
    framings Json @default("{}")

    timeline Event[]
    views    View[]

    @@index([status, createdAt])
}

/// Append-only. One row per applied action.
///
/// `what` is the English rendering of the action, which is all a timeline needs.
/// `type` and `payload` keep the action itself, so the reducer can replay the
/// log and rebuild any version the object has ever been. Nullable because rows
/// written before this existed cannot be replayed and must not be guessed at.
model Event {
    id      String      @id @default(cuid())
    issueId String
    issue   Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
    at      DateTime    @default(now())
    by      String
    what    String
    type    ActionType?
    payload Json        @default("{}")

    @@index([issueId, at])
}

/// A live window onto one issue. Web connections are not persisted; they die
/// with the browser tab. Only message-backed views survive a restart.
model View {
    id       String   @id @default(cuid())
    issueId  String
    issue    Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
    surface  Surface
    audience Audience

    channel   String?
    ts        String?
    chatId    BigInt?
    messageId Int?

    @@unique([issueId, surface, audience, chatId])
    @@index([issueId])
}
