# --- Database ---
# The team shares one hosted Postgres so every developer sees the same issues.
# Ask another developer for the real URL; it is never committed.
# Shape: postgres://<user>:<password>@db.prisma.io:5432/postgres?sslmode=require
DATABASE_URL=
#
# To work alone against a throwaway local database instead:
#   docker compose up -d
#   DATABASE_URL=postgresql://shared:shared@localhost:5433/shared_object

# --- Slack ---
# Bot User OAuth Token. Install App -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-
# App-Level Token. Basic Information -> App-Level Tokens, scope connections:write
SLACK_APP_TOKEN=xapp-
# Channel ID. Right-click channel -> Copy link, the C... at the end
SLACK_CHANNEL_ID=C

# --- Telegram ---
# From @BotFather via /newbot
TELEGRAM_BOT_TOKEN=
# Message the bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# --- Model (needed at M3, not before) ---
# Any OpenAI-compatible endpoint. Both readers — the server's agent and the
# web route's CopilotKit runtime — send LLM_MODEL to LLM_BASE_URL verbatim, so
# the id has to be spelled the way that endpoint spells it: namespaced for
# OpenRouter, bare for OpenAI itself.
#
# OpenRouter (an sk-or-v1-... key from openrouter.ai/keys):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=openai/gpt-4.1-mini
#
# OpenAI directly (an sk-... key):
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4.1-mini

# --- Local ports ---
WEB_PORT=5100
SERVER_PORT=5101
NEXT_PUBLIC_SERVER_URL=http://localhost:5101
